# PGx Platform V2 - example environment (WP-02).
#
# Copy to .env and adjust. NEVER commit a real .env: .gitignore excludes it.
# Every value here is a development-only placeholder, not a credential.

# ---------------------------------------------------------------------------
# Application database  ->  compose service `postgres`, host port 5432
# ---------------------------------------------------------------------------
# Only PostgreSQL is accepted. A bare postgresql:// URL is normalised to
# postgresql+psycopg:// so it can never fall back to psycopg2; any other
# explicit driver, and any sqlite:// URL, is rejected with a clear error.
DATABASE_URL=postgresql+psycopg://pgx_dev:pgx_dev_password@localhost:5432/pgx_dev

POSTGRES_USER=pgx_dev
POSTGRES_PASSWORD=pgx_dev_password
POSTGRES_DB=pgx_dev
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Test database  ->  compose service `postgres-test`, host port 55432
# ---------------------------------------------------------------------------
# A SEPARATE server on a SEPARATE port with tmpfs storage. Integration tests
# run `alembic downgrade base`, so they must never reach the development
# database. They read ONLY this variable, and they refuse to run unless the
# database name contains "test".
#
# Start it with:  docker compose --profile test up -d postgres-test
TEST_DATABASE_URL=postgresql+psycopg://pgx_dev:pgx_dev_password@localhost:55432/pgx_test

TEST_POSTGRES_USER=pgx_dev
TEST_POSTGRES_PASSWORD=pgx_dev_password
TEST_POSTGRES_DB=pgx_test
TEST_POSTGRES_HOST_PORT=55432

# ---------------------------------------------------------------------------
# Connection pool (optional; defaults live in pgx/infrastructure/db/config.py)
# ---------------------------------------------------------------------------
PGX_DB_POOL_SIZE=5
PGX_DB_MAX_OVERFLOW=5
PGX_DB_POOL_TIMEOUT_SECONDS=30
PGX_DB_POOL_RECYCLE_SECONDS=1800
PGX_DB_ECHO=false

# ---------------------------------------------------------------------------
# API application (WP-16). Defaults live in apps/api/config.py.
# ---------------------------------------------------------------------------
# Every variable here is optional, and every default is the production-safe
# one. An unset environment produces a PRODUCTION deployment with no
# authentication provider, no interactive documentation and no CORS origin -
# which serves its health routes honestly and refuses everything else.
#
# PGX_API_ENV: PRODUCTION | STAGING | DEVELOPMENT | TEST. Default PRODUCTION.
# Only PRODUCTION changes a default, and it does so by refusing things: static
# development tokens, interactive documentation and a wildcard CORS origin are
# all rejected outright there rather than merely defaulted off.
PGX_API_ENV=DEVELOPMENT

# PGX_API_AUTH_MODE: UNCONFIGURED | STATIC_TOKEN | SESSION.
# Default UNCONFIGURED.
#
# This block was stale until WP-24: it said "WP-23 replaces both", and WP-23
# did - it added SESSION - without the file being updated. Corrected here in
# the open rather than quietly, because a configuration example that describes
# a version of the software that no longer exists is worse than none.
#
# UNCONFIGURED is not "authentication disabled". It means no principal can be
# established, so every authenticated route answers 503
# AUTHENTICATION_NOT_CONFIGURED and the `authentication` readiness component
# reports not ready. It never invents a demo or admin principal.
#
# STATIC_TOKEN maps fixed development tokens to principals. Development and
# test ONLY: apps/api/config.py refuses it in PRODUCTION, and it records
# TEST_STATIC_TOKEN assurance on every audit row so a development run stays
# distinguishable from a person forever.
#
# SESSION is the only production-capable mode. It reads the governed
# __Host-pgx_session cookie and nothing else - not the Authorization header,
# and not "whichever works", because a resolver that accepted both would leave
# a production deployment honouring development tokens silently.
#
# Setting SESSION does not make a deployment authenticated. The status is
# derived from what composition actually built (an engine, an Argon2 hasher, a
# session store); a variable can name a configuration the host cannot provide,
# and `pgx-deploy preflight` reports which pieces are missing.
PGX_API_AUTH_MODE=UNCONFIGURED

# Interactive documentation. Default: on outside production, refused inside it.
PGX_API_DOCS_ENABLED=true

# Cross-origin policy. Default: empty, so no origin is allowed. A comma-
# separated list of scheme://host[:port] origins, at most 16 - a longer list is
# a policy nobody reviews. A wildcard is refused in production, and credentials
# are never sent to a wildcard origin in any environment.
PGX_API_CORS_ALLOWED_ORIGINS=
PGX_API_CORS_ALLOW_CREDENTIALS=false

# Maximum request body, in bytes. Default 65536, permitted range 1 KiB - 1 MiB.
# The assessment contract bounds every field, so a larger limit buys nothing
# and costs a memory-exhaustion surface.
PGX_API_MAX_BODY_BYTES=65536

# Budget for the whole readiness probe, in seconds. Above zero, at most 10.
# A readiness endpoint that can hang is one an orchestrator cannot act on.
PGX_API_READINESS_TIMEOUT_SECONDS=2.0

# Optional. The evidence build the evidence endpoint reads. Its absence is
# reported as an advisory (non-blocking) readiness component: the evidence
# route needs it and an assessment does not.
PGX_API_EVIDENCE_BUILD_PATH=

# Optional. The Alembic revision this build expects. When set, readiness
# compares it against the database's current head.
PGX_API_MIGRATION_HEAD=

# ---------------------------------------------------------------------------
# WP-24 deployment. Defaults live in pgx/deployment/.
# ---------------------------------------------------------------------------
# SECRETS ARE FILES. Every variable below has a *_FILE twin, and the file form
# is preferred everywhere: an environment variable is visible in
# `docker inspect`, in a crash dump and in the process table.
#
# Setting BOTH a variable and its _FILE twin is REFUSED rather than resolved.
# A precedence rule would let an operator who rotated the file and forgot the
# variable keep running on the old secret, with nothing anywhere saying so.
#
# None of these has a working default. An example credential that happens to
# be valid is a credential.

# The application DSN. Only PostgreSQL, only the psycopg driver.
#   DATABASE_URL_FILE=/run/secrets/database_url
DATABASE_URL_FILE=

# Optional. Read and validated if present, and NOT required - which is a
# statement about WP-23's design rather than a relaxation: CSRF tokens are
# keyed per session from SessionRecord.csrf_secret, and the login form from
# the short-lived __Host-pgx_preauth cookie the server just set. Neither
# derives from a deployment-wide key, so requiring one would add a secret to
# rotate, mount and leak that nothing verifies.
PGX_CSRF_SECRET_FILE=

# Read only by `pgx-deploy backup`, and only while a backup is being taken.
# Never committed, never printed, never in an artifact.
PGX_BACKUP_ENCRYPTION_KEY_FILE=

# The SEPARATE database a restore is verified into. Restoring into the source
# proves the archive is readable and destroys what you were protecting.
PGX_RESTORE_TARGET_URL_FILE=

# The Alembic revision this build expects. Readiness compares it against the
# database's current head and reports `migrations_behind` when they differ.
PGX_API_MIGRATION_HEAD=0011_wp23_auth_audit

# The staging TLS material, mounted into the proxy. deploy/tls/ is excluded by
# .gitignore and .dockerignore; a key committed there is a secret-scan finding,
# not an exception.
PGX_TLS_CERT=/etc/caddy/tls/server.crt
PGX_TLS_KEY=/etc/caddy/tls/server.key
PGX_HTTPS_PORT=8443

# The isolated Compose project name for a local rehearsal. Not optional and
# not defaulted: Compose derives a project name from the directory when none
# is given, which would make this topology share a namespace - and volumes -
# with the development one.
#   docker compose -p pgx_wp24_rehearsal -f docker-compose.wp24.yml up -d
PGX_POSTGRES_DB=pgx_staging
PGX_RESTORE_DB=pgx_restore_check
PGX_APP_HOST_PORT=8080

# There is deliberately NO variable that weakens the session cookie. WP-23's
# SessionPolicy raises if Secure or HttpOnly is false and refuses
# SameSite=None; a flag that could turn either off is a flag somebody sets
# while testing and never sets back. Terminate TLS instead.
