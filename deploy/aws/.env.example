# A Lightsail static public IPv4 address, or a DNS name pointing to it.
# Caddy obtains a public certificate for either form. Do not include a scheme
# (https://), port, or path.
DOMAIN=203.0.113.10

# Local image tag. Change only when you deliberately manage multiple builds.
PGX_IMAGE=pgx-platform:aws

# Account created by `./deploy/aws/deploy.sh bootstrap`.
PGX_DEMO_USER=demo
