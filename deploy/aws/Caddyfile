# Public AWS ingress. A DNS name or public IPv4 address is supplied through
# DOMAIN. Let's Encrypt IP certificates use its short-lived certificate
# profile and HTTP-01 validation. Caddy renews them automatically and creates
# the HTTP -> HTTPS redirect, so no key is stored in this repository.
{
	admin off
}

{$DOMAIN} {
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
			# HTTP-01 works for both DNS names and IPv4 address certificates.
			disable_tlsalpn_challenge
		}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format json
	}

	reverse_proxy app:8000 {
		# Caddy supplies X-Forwarded-Proto and X-Forwarded-For by default.
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
