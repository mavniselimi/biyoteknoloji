{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgx-platform.invalid/schemas/phenotype-regression-report.schema.json",
  "title": "PGx phenotype legacy regression report",
  "description": "The deterministic comparison between legacy phenotype matching and WP-12's, over the six legacy demo profiles plus the constructed cases the demo profiles cannot exercise. It compares normalisation verdicts and matcher semantics only: there is no approved ruleset, so there is no clinical output to compare, and the schema carries no field in which one could appear. The report requires unexpected_differences to be present so it cannot be omitted when it is non-empty, and requires expected_differences_not_observed for the same reason in the other direction - an allowlisted difference that quietly stops happening is as much a change as one that appears.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_schema_version",
    "input_contract_version",
    "source_profiles",
    "profile_count",
    "profiles",
    "constructed_cross_match_cases",
    "constructed_broad_group_case",
    "expected_differences",
    "expected_difference_hits",
    "expected_differences_not_observed",
    "unexpected_differences",
    "note",
    "content_hash"
  ],
  "properties": {
    "report_schema_version": {
      "const": "pgx-phenotype-regression-report/1"
    },
    "input_contract_version": {
      "const": "pgx-phenotype-input/1"
    },
    "source_profiles": {
      "description": "The legacy artifact read, by repository-relative path. Read-only: a test asserts its digest is unchanged by this harness.",
      "type": "string",
      "minLength": 1
    },
    "profile_count": {
      "type": "integer",
      "minimum": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "profile_content_hash",
          "gene_count",
          "genes"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "profile_content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "gene_count": {
            "type": "integer",
            "minimum": 0
          },
          "genes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "gene_id",
                "raw_value",
                "v2_status",
                "v2_phenotype",
                "v2_reason_code",
                "legacy_normalized",
                "match_rows"
              ],
              "properties": {
                "gene_id": {
                  "type": "string",
                  "pattern": "^GENE:[A-Z0-9][A-Z0-9\\-.@_]*$"
                },
                "raw_value": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "v2_status": {
                  "enum": [
                    "NORMALIZED",
                    "MISSING",
                    "INDETERMINATE",
                    "UNSUPPORTED"
                  ]
                },
                "v2_phenotype": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "enum": [
                        "POOR",
                        "INTERMEDIATE",
                        "NORMAL",
                        "RAPID",
                        "ULTRARAPID"
                      ]
                    }
                  ]
                },
                "v2_reason_code": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]*$"
                    }
                  ]
                },
                "legacy_normalized": {
                  "description": "What the legacy normaliser made of the same value, including its invented decreased_function group. Recorded as evidence, never consumed.",
                  "type": "string"
                },
                "match_rows": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/match_row"
                  }
                }
              }
            }
          }
        }
      }
    },
    "constructed_cross_match_cases": {
      "description": "The RAPID/ULTRARAPID cases. Marked constructed because no demo profile supplies a RAPID value, which is exactly why WP-01 registered LEGACY-BUG-001 without a selector rather than fabricating one.",
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/constructed_case"
      }
    },
    "constructed_broad_group_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "raw_value",
        "legacy_normalized",
        "legacy_matches_poor_rule",
        "legacy_matches_intermediate_rule",
        "v2_status",
        "v2_reason_code",
        "v2_phenotype",
        "expected_difference_id"
      ],
      "properties": {
        "case": {
          "const": "constructed"
        },
        "raw_value": {
          "type": "string"
        },
        "legacy_normalized": {
          "type": "string"
        },
        "legacy_matches_poor_rule": {
          "type": "boolean"
        },
        "legacy_matches_intermediate_rule": {
          "type": "boolean"
        },
        "v2_status": {
          "const": "UNSUPPORTED"
        },
        "v2_reason_code": {
          "const": "PHENOTYPE_INPUT_BROAD_GROUP_NOT_ALLOWED"
        },
        "v2_phenotype": {
          "description": "Always null. A broad functional group must never resolve to a P0 phenotype, and the schema pins that rather than trusting the producer.",
          "type": "null"
        },
        "expected_difference_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected_differences": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/expected_difference"
      }
    },
    "expected_difference_hits": {
      "description": "How many comparisons each allowlisted difference explained. A zero means an intended difference stopped happening, which needs review rather than silence.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9-]*$"
      }
    },
    "expected_differences_not_observed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unexpected_differences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "gene_id",
          "observed",
          "operator",
          "declared",
          "legacy_matched",
          "v2_status"
        ],
        "properties": {
          "profile_id": {
            "type": "string"
          },
          "gene_id": {
            "type": "string"
          },
          "observed": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "operator": {
            "enum": [
              "EXACT",
              "ONE_OF"
            ]
          },
          "declared": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "legacy_matched": {
            "type": "boolean"
          },
          "v2_status": {
            "type": "string"
          }
        }
      }
    },
    "note": {
      "type": "string",
      "minLength": 100
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "match_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "declared",
        "legacy_matched",
        "v2_status",
        "v2_matched",
        "differs"
      ],
      "properties": {
        "operator": {
          "enum": [
            "EXACT",
            "ONE_OF"
          ]
        },
        "declared": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "POOR",
              "INTERMEDIATE",
              "NORMAL",
              "RAPID",
              "ULTRARAPID"
            ]
          }
        },
        "legacy_matched": {
          "type": "boolean"
        },
        "v2_status": {
          "enum": [
            "MATCH",
            "NO_MATCH",
            "INPUT_MISSING",
            "INPUT_INDETERMINATE",
            "INPUT_UNSUPPORTED"
          ]
        },
        "v2_matched": {
          "type": "boolean"
        },
        "differs": {
          "type": "boolean"
        },
        "expected_difference_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constructed_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "observed",
        "operator",
        "declared",
        "legacy_matched",
        "v2_status",
        "v2_matched",
        "differs",
        "expected_difference_id"
      ],
      "properties": {
        "case": {
          "const": "constructed"
        },
        "observed": {
          "enum": [
            "POOR",
            "INTERMEDIATE",
            "NORMAL",
            "RAPID",
            "ULTRARAPID"
          ]
        },
        "operator": {
          "enum": [
            "EXACT",
            "ONE_OF"
          ]
        },
        "declared": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "POOR",
              "INTERMEDIATE",
              "NORMAL",
              "RAPID",
              "ULTRARAPID"
            ]
          }
        },
        "legacy_matched": {
          "type": "boolean"
        },
        "v2_status": {
          "enum": [
            "MATCH",
            "NO_MATCH",
            "INPUT_MISSING",
            "INPUT_INDETERMINATE",
            "INPUT_UNSUPPORTED"
          ]
        },
        "v2_matched": {
          "type": "boolean"
        },
        "differs": {
          "type": "boolean"
        },
        "expected_difference_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "expected_difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "difference_id",
        "legacy_bug_id",
        "observed_legacy_behavior",
        "required_v2_behavior",
        "safety_rationale",
        "reference",
        "comparison_selector",
        "expected_status"
      ],
      "properties": {
        "difference_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "legacy_bug_id": {
          "type": "string",
          "pattern": "^LEGACY-BUG-[0-9]{3}$"
        },
        "observed_legacy_behavior": {
          "type": "string",
          "minLength": 40
        },
        "required_v2_behavior": {
          "type": "string",
          "minLength": 30
        },
        "safety_rationale": {
          "description": "Why the difference is an improvement rather than a regression. Required, and required to be substantive: a difference nobody justified is a difference nobody decided.",
          "type": "string",
          "minLength": 40
        },
        "reference": {
          "type": "string",
          "minLength": 5
        },
        "comparison_selector": {
          "type": "object",
          "minProperties": 1
        },
        "expected_status": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
