{
  "$defs": {
    "coverageResult": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "reason_codes": {
                "minItems": 1
              }
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "FULL"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason_codes": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "description": "The whole answer for one coverage request, pinned to the profile, coverage manifest, ruleset, dataset and evidence build it was computed against, each by identity and hash. A stored result can therefore be checked against the artifacts that produced it rather than against whatever is on disk today. At least one medication is required: an empty request has no answer, and reporting FULL for one would be the emptiest possible reassurance. additionalProperties is false throughout, which is where the separation of coverage from attention is actually enforced: an attention level, an overall_attention, a risk level, a risk score, a severity, a dose, a recommendation, a preferred or safer flag, a suitability score or a treatment cannot be attached to any of these documents by anything downstream, because the schema refuses every property it does not name. WP-13 computes coverage; WP-14 computes attention; a document that could carry both would let one be read as the other. PARTIAL is required to carry SOME_AXES_NOT_COVERED; that is enforced by the model and by test, not here, because the supported schema keyword set has no way to require a specific array member and this project's validator refuses any keyword it cannot actually check.",
      "properties": {
        "canonical_build_content_hash": {
          "anyOf": [
            {
              "maxLength": 0,
              "type": "string"
            },
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          ]
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "coverage_manifest_hash": {
          "anyOf": [
            {
              "maxLength": 0,
              "type": "string"
            },
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          ]
        },
        "coverage_result_schema_version": {
          "const": "pgx-coverage-result/1"
        },
        "dataset_public_id": {
          "type": "string"
        },
        "evidence_build_content_hash": {
          "anyOf": [
            {
              "maxLength": 0,
              "type": "string"
            },
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          ]
        },
        "evidence_build_key": {
          "type": "string"
        },
        "medication_count": {
          "minimum": 1,
          "type": "integer"
        },
        "medications": {
          "items": {
            "additionalProperties": false,
            "allOf": [
              {
                "else": {
                  "properties": {
                    "reason_codes": {
                      "minItems": 1
                    }
                  }
                },
                "if": {
                  "properties": {
                    "status": {
                      "const": "FULL"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "axes": {
                      "minItems": 1
                    },
                    "reason_codes": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ],
            "properties": {
              "axes": {
                "items": {
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "else": {
                        "properties": {
                          "reason_codes": {
                            "minItems": 1
                          }
                        }
                      },
                      "if": {
                        "properties": {
                          "status": {
                            "const": "FULL"
                          }
                        },
                        "required": [
                          "status"
                        ]
                      },
                      "then": {
                        "properties": {
                          "evidence_references": {
                            "minItems": 1
                          },
                          "observed_phenotype": {
                            "enum": [
                              "POOR",
                              "INTERMEDIATE",
                              "NORMAL",
                              "RAPID",
                              "ULTRARAPID"
                            ]
                          },
                          "reason_codes": {
                            "maxItems": 0
                          },
                          "rule_references": {
                            "minItems": 1
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "SOURCE_CONFLICT"
                          }
                        },
                        "required": [
                          "status"
                        ]
                      },
                      "then": {
                        "properties": {
                          "conflict_references": {
                            "minItems": 1
                          }
                        }
                      }
                    }
                  ],
                  "properties": {
                    "axis_coverage_schema_version": {
                      "const": "pgx-axis-coverage/1"
                    },
                    "canonical_build_content_hash": {
                      "anyOf": [
                        {
                          "maxLength": 0,
                          "type": "string"
                        },
                        {
                          "pattern": "^sha256:[0-9a-f]{64}$",
                          "type": "string"
                        }
                      ]
                    },
                    "conflict_references": {
                      "items": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "type": "array",
                      "uniqueItems": true
                    },
                    "coverage_manifest_hash": {
                      "anyOf": [
                        {
                          "maxLength": 0,
                          "type": "string"
                        },
                        {
                          "pattern": "^sha256:[0-9a-f]{64}$",
                          "type": "string"
                        }
                      ]
                    },
                    "dataset_public_id": {
                      "type": "string"
                    },
                    "declaration_id": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "minLength": 1,
                          "type": "string"
                        }
                      ]
                    },
                    "drug_id": {
                      "pattern": "^DRUG:[^A-Z\\s]+( [^A-Z\\s]+)*$",
                      "type": "string"
                    },
                    "evidence_references": {
                      "items": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "type": "array",
                      "uniqueItems": true
                    },
                    "gene_id": {
                      "pattern": "^GENE:[A-Z0-9][A-Z0-9\\-.@_]*$",
                      "type": "string"
                    },
                    "observation_state": {
                      "type": "string"
                    },
                    "observed_phenotype": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "enum": [
                            "POOR",
                            "INTERMEDIATE",
                            "NORMAL",
                            "RAPID",
                            "ULTRARAPID"
                          ]
                        }
                      ]
                    },
                    "reason_codes": {
                      "items": {
                        "enum": [
                          "DRUG_NOT_IN_CANONICAL_DATASET",
                          "PHENOTYPE_NOT_PROVIDED",
                          "PHENOTYPE_NOT_SUPPORTED",
                          "NO_VALIDATED_RULE_FOR_AXIS",
                          "SOME_AXES_NOT_COVERED",
                          "VALIDATED_RULES_CONFLICT",
                          "DATASET_RULESET_MISMATCH",
                          "EVIDENCE_REFERENCE_MISSING"
                        ]
                      },
                      "type": "array",
                      "uniqueItems": true
                    },
                    "rule_references": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "rule_content_hash": {
                            "anyOf": [
                              {
                                "maxLength": 0,
                                "type": "string"
                              },
                              {
                                "pattern": "^sha256:[0-9a-f]{64}$",
                                "type": "string"
                              }
                            ]
                          },
                          "rule_id": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "rule_version": {
                            "minimum": 0,
                            "type": "integer"
                          }
                        },
                        "required": [
                          "rule_id",
                          "rule_version",
                          "rule_content_hash"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "ruleset_content_hash": {
                      "anyOf": [
                        {
                          "maxLength": 0,
                          "type": "string"
                        },
                        {
                          "pattern": "^sha256:[0-9a-f]{64}$",
                          "type": "string"
                        }
                      ]
                    },
                    "ruleset_public_id": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "FULL",
                        "PARTIAL",
                        "INSUFFICIENT",
                        "UNSUPPORTED_DRUG",
                        "UNSUPPORTED_PHENOTYPE",
                        "SOURCE_CONFLICT"
                      ]
                    }
                  },
                  "required": [
                    "axis_coverage_schema_version",
                    "drug_id",
                    "gene_id",
                    "status",
                    "reason_codes",
                    "observed_phenotype",
                    "observation_state",
                    "declaration_id",
                    "rule_references",
                    "evidence_references",
                    "conflict_references",
                    "ruleset_public_id",
                    "ruleset_content_hash",
                    "dataset_public_id",
                    "canonical_build_content_hash",
                    "coverage_manifest_hash"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "axis_count": {
                "minimum": 0,
                "type": "integer"
              },
              "medication": {
                "additionalProperties": false,
                "properties": {
                  "drug_id": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "minLength": 1,
                        "type": "string"
                      }
                    ]
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "requested_value": {
                    "type": "string"
                  },
                  "state": {
                    "enum": [
                      "RECOGNIZED",
                      "NOT_IN_CANONICAL_DATASET",
                      "INVALID"
                    ]
                  }
                },
                "required": [
                  "requested_value",
                  "state",
                  "drug_id",
                  "reason"
                ],
                "type": "object"
              },
              "medication_coverage_schema_version": {
                "const": "pgx-medication-coverage/1"
              },
              "reason_codes": {
                "items": {
                  "enum": [
                    "DRUG_NOT_IN_CANONICAL_DATASET",
                    "PHENOTYPE_NOT_PROVIDED",
                    "PHENOTYPE_NOT_SUPPORTED",
                    "NO_VALIDATED_RULE_FOR_AXIS",
                    "SOME_AXES_NOT_COVERED",
                    "VALIDATED_RULES_CONFLICT",
                    "DATASET_RULESET_MISMATCH",
                    "EVIDENCE_REFERENCE_MISSING"
                  ]
                },
                "type": "array",
                "uniqueItems": true
              },
              "status": {
                "enum": [
                  "FULL",
                  "PARTIAL",
                  "INSUFFICIENT",
                  "UNSUPPORTED_DRUG",
                  "UNSUPPORTED_PHENOTYPE",
                  "SOURCE_CONFLICT"
                ]
              }
            },
            "required": [
              "medication_coverage_schema_version",
              "medication",
              "status",
              "reason_codes",
              "axis_count",
              "axes"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "note": {
          "minLength": 100,
          "type": "string"
        },
        "profile_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "enum": [
              "DRUG_NOT_IN_CANONICAL_DATASET",
              "PHENOTYPE_NOT_PROVIDED",
              "PHENOTYPE_NOT_SUPPORTED",
              "NO_VALIDATED_RULE_FOR_AXIS",
              "SOME_AXES_NOT_COVERED",
              "VALIDATED_RULES_CONFLICT",
              "DATASET_RULESET_MISMATCH",
              "EVIDENCE_REFERENCE_MISSING"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "ruleset_content_hash": {
          "anyOf": [
            {
              "maxLength": 0,
              "type": "string"
            },
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          ]
        },
        "ruleset_public_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "FULL",
            "PARTIAL",
            "INSUFFICIENT",
            "UNSUPPORTED_DRUG",
            "UNSUPPORTED_PHENOTYPE",
            "SOURCE_CONFLICT"
          ]
        }
      },
      "required": [
        "coverage_result_schema_version",
        "status",
        "reason_codes",
        "medication_count",
        "medications",
        "profile_content_hash",
        "coverage_manifest_hash",
        "ruleset_public_id",
        "ruleset_content_hash",
        "dataset_public_id",
        "canonical_build_content_hash",
        "evidence_build_key",
        "evidence_build_content_hash",
        "note",
        "content_hash"
      ],
      "type": "object"
    }
  },
  "$id": "https://pgx-platform.invalid/schemas/assessment-computation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_attention": {
            "const": "NO_ACTIVE_ATTENTION"
          }
        },
        "required": [
          "overall_attention"
        ]
      },
      "then": {
        "properties": {
          "overall_coverage": {
            "const": "FULL"
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "overall_coverage_reason_codes": {
            "minItems": 1
          }
        }
      },
      "if": {
        "properties": {
          "overall_coverage": {
            "const": "FULL"
          }
        },
        "required": [
          "overall_coverage"
        ]
      },
      "then": {
        "properties": {
          "overall_coverage_reason_codes": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "description": "The calculated facts of one assessment. output_hash covers this document and therefore covers every calculated fact and every pinned version. It excludes the assessment id, the actor, the clock, database insertion order, local paths, the process, runtime duration, UI labels, report prose and the active pointer generation - so two executions of the same question against the same pinned release hash identically even when their ids, actors and timestamps differ. assessment_id and persisted are optional envelope fields for a stored record and are not part of the hashed content. NO_ACTIVE_ATTENTION at the top requires FULL overall coverage. additionalProperties is false throughout, which is where the boundary is actually enforced: a dose, a recommendation, a preferred or safer flag, a suitability score, a ranking, a treatment or a rendered sentence cannot be attached to any of these documents by anything downstream, because the schema refuses every property it does not name. WP-14 calculates structured facts; WP-15 renders them.",
  "properties": {
    "assessment_engine_contract_version": {
      "const": "pgx-assessment-engine/2"
    },
    "assessment_id": {
      "minLength": 1,
      "type": "string"
    },
    "computation_schema_version": {
      "const": "pgx-assessment-computation/2"
    },
    "coverage_result": {
      "$ref": "#/$defs/coverageResult",
      "description": "The complete WP-13 coverage result, embedded rather than summarised. A report must be able to show every axis, its status, its observed phenotype, its reason codes and its rule, evidence and conflict references without recomputing any of them. This subschema is the published coverage-result schema inlined verbatim; a test asserts the two cannot drift."
    },
    "coverage_result_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "finding_count": {
      "minimum": 0,
      "type": "integer"
    },
    "input_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "medication_count": {
      "minimum": 1,
      "type": "integer"
    },
    "medications": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "attention_level": {
                  "const": "NO_ACTIVE_ATTENTION"
                }
              },
              "required": [
                "attention_level"
              ]
            },
            "then": {
              "properties": {
                "coverage_status": {
                  "const": "FULL"
                }
              }
            }
          },
          {
            "else": {
              "properties": {
                "coverage_reason_codes": {
                  "minItems": 1
                }
              }
            },
            "if": {
              "properties": {
                "coverage_status": {
                  "const": "FULL"
                }
              },
              "required": [
                "coverage_status"
              ]
            },
            "then": {
              "properties": {
                "coverage_reason_codes": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "attention_level": {
                  "const": "NOT_ASSESSED"
                }
              },
              "required": [
                "attention_level"
              ]
            },
            "then": {
              "properties": {
                "finding_count": {
                  "maximum": 0
                },
                "findings": {
                  "maxItems": 0
                }
              }
            }
          }
        ],
        "properties": {
          "attention_level": {
            "enum": [
              "NOT_ASSESSED",
              "NO_ACTIVE_ATTENTION",
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "axis_count": {
            "minimum": 0,
            "type": "integer"
          },
          "conflicted_axis_count": {
            "minimum": 0,
            "type": "integer"
          },
          "coverage_reason_codes": {
            "items": {
              "enum": [
                "DRUG_NOT_IN_CANONICAL_DATASET",
                "PHENOTYPE_NOT_PROVIDED",
                "PHENOTYPE_NOT_SUPPORTED",
                "NO_VALIDATED_RULE_FOR_AXIS",
                "SOME_AXES_NOT_COVERED",
                "VALIDATED_RULES_CONFLICT",
                "DATASET_RULESET_MISMATCH",
                "EVIDENCE_REFERENCE_MISSING"
              ]
            },
            "type": "array",
            "uniqueItems": true
          },
          "coverage_status": {
            "enum": [
              "FULL",
              "PARTIAL",
              "INSUFFICIENT",
              "UNSUPPORTED_DRUG",
              "UNSUPPORTED_PHENOTYPE",
              "SOURCE_CONFLICT"
            ]
          },
          "drug_id": {
            "minLength": 1,
            "type": "string"
          },
          "finding_count": {
            "minimum": 0,
            "type": "integer"
          },
          "findings": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "attention_level": {
                  "enum": [
                    "NO_ACTIVE_ATTENTION",
                    "LOW",
                    "MEDIUM",
                    "HIGH"
                  ]
                },
                "canonical_build_content_hash": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "coverage_manifest_hash": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "curation_revision_hash": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "curation_revision_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "dataset_public_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "drug_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "effect_code": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "minLength": 1,
                      "type": "string"
                    }
                  ]
                },
                "evidence_references": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "explanation_code": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "minLength": 1,
                      "type": "string"
                    }
                  ]
                },
                "finding_schema_version": {
                  "const": "pgx-assessment-finding/1"
                },
                "gene_id": {
                  "pattern": "^GENE:[A-Z0-9][A-Z0-9\\-.@_]*$",
                  "type": "string"
                },
                "phenotype": {
                  "enum": [
                    "POOR",
                    "INTERMEDIATE",
                    "NORMAL",
                    "RAPID",
                    "ULTRARAPID"
                  ]
                },
                "rationale_reference": {
                  "minLength": 1,
                  "type": "string"
                },
                "rule_content_hash": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "rule_family_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "rule_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "rule_version": {
                  "minimum": 1,
                  "type": "integer"
                },
                "ruleset_content_hash": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "ruleset_public_id": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "attention_level",
                "canonical_build_content_hash",
                "coverage_manifest_hash",
                "curation_revision_hash",
                "curation_revision_id",
                "dataset_public_id",
                "drug_id",
                "effect_code",
                "evidence_references",
                "explanation_code",
                "finding_schema_version",
                "gene_id",
                "phenotype",
                "rationale_reference",
                "rule_content_hash",
                "rule_family_id",
                "rule_id",
                "rule_version",
                "ruleset_content_hash",
                "ruleset_public_id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "medication_assessment_schema_version": {
            "const": "pgx-medication-assessment/1"
          },
          "requested_value": {
            "type": "string"
          }
        },
        "required": [
          "attention_level",
          "axis_count",
          "conflicted_axis_count",
          "coverage_reason_codes",
          "coverage_status",
          "drug_id",
          "finding_count",
          "findings",
          "medication_assessment_schema_version",
          "requested_value"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "note": {
      "minLength": 100,
      "type": "string"
    },
    "output_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "overall_attention": {
      "enum": [
        "NOT_ASSESSED",
        "NO_ACTIVE_ATTENTION",
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "overall_coverage": {
      "enum": [
        "FULL",
        "PARTIAL",
        "INSUFFICIENT",
        "UNSUPPORTED_DRUG",
        "UNSUPPORTED_PHENOTYPE",
        "SOURCE_CONFLICT"
      ]
    },
    "overall_coverage_reason_codes": {
      "items": {
        "enum": [
          "DRUG_NOT_IN_CANONICAL_DATASET",
          "PHENOTYPE_NOT_PROVIDED",
          "PHENOTYPE_NOT_SUPPORTED",
          "NO_VALIDATED_RULE_FOR_AXIS",
          "SOME_AXES_NOT_COVERED",
          "VALIDATED_RULES_CONFLICT",
          "DATASET_RULESET_MISMATCH",
          "EVIDENCE_REFERENCE_MISSING"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "persisted": {
      "type": "boolean"
    },
    "pointer_audit": {
      "additionalProperties": false,
      "description": "Provenance recorded on the assessment and deliberately excluded from output_hash. The pointer generation says where in the WP-03 pointer's history this release was pinned; it is audit metadata about the execution, not a fact about the case, and the same question against the same release bundle hashes identically whatever it was.",
