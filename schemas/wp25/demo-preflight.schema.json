{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "preflight_state": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "preflight_state"
        ]
      },
      "then": {
        "properties": {
          "demo_executed": {
            "const": false
          },
          "exit_code": {
            "const": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "demo_executed": {
            "const": true
          }
        },
        "required": [
          "demo_executed"
        ]
      },
      "then": {
        "properties": {
          "preflight_state": {
            "const": "READY"
          },
          "stopped_at_step_id": {
            "type": "null"
          }
        }
      }
    }
  ],
  "description": "The preflight result. A BLOCKED preflight must record ``demo_executed: false``: the whole point is that nothing was run past the first unmet precondition.",
  "properties": {
    "blocker_count": {
      "minimum": 0,
      "type": "integer"
    },
    "blockers": {
      "items": {
        "properties": {
          "blocking": {
            "const": true,
            "type": "boolean"
          },
          "code": {
            "enum": [
              "THS6_AUDIT_CHAIN_UNVERIFIED",
              "THS6_BACKUP_RESTORE_NOT_VERIFIED",
              "THS6_BENCHMARK_NOT_EXECUTED",
              "THS6_CI_NOT_EXECUTED",
              "THS6_CLAIM_BOUNDARY_NOT_APPROVED",
              "THS6_CONTAINER_RUNTIME_UNAVAILABLE",
              "THS6_CURATION_PROTOCOL_NOT_APPROVED",
              "THS6_DATABASE_UNAVAILABLE",
              "THS6_DATASET_NOT_PUBLISHED",
              "THS6_DEMO_NOT_EXECUTED",
              "THS6_DEPLOYMENT_GATE_BLOCKED",
              "THS6_DOD_DECLARED_COUNT_MISMATCH",
              "THS6_EVIDENCE_BUILD_NOT_APPROVED",
              "THS6_EVIDENCE_INVALID",
              "THS6_EVIDENCE_STALE",
              "THS6_EVIDENCE_UNAVAILABLE",
              "THS6_EXPERT_PROTOCOL_NOT_APPROVED",
              "THS6_INSUFFICIENT_VALIDATION_CASES",
              "THS6_LEGACY_WORK_ITEMS_UNLINKED",
              "THS6_MIGRATION_NOT_EXECUTED",
              "THS6_NO_ACTIVE_RELEASE",
              "THS6_NO_APPROVED_RULE",
              "THS6_NO_APPROVED_SOURCE",
              "THS6_NO_COMPLETED_REVIEW",
              "THS6_NO_COMPUTED_METRIC",
              "THS6_NO_COVERAGE_EXECUTION",
              "THS6_NO_CURATED_INTERPRETATION",
              "THS6_NO_EXECUTABLE_RULESET",
              "THS6_NO_HOLDOUT_SET",
              "THS6_NO_HUMAN_SIGNOFF",
              "THS6_NO_NAMED_REVIEWER",
              "THS6_NO_REAL_ASSESSMENT",
              "THS6_PROSE_INVENTORY_DISCREPANCY",
              "THS6_SAFETY_CI_NOT_EXECUTED",
              "THS6_SAFETY_GATE_BLOCKED",
              "THS6_SECURITY_GATE_BLOCKED",
              "THS6_SNAPSHOT_QUARANTINED",
              "THS6_SOURCE_ARTIFACT_DISAGREEMENT",
              "THS6_SOURCE_DOCUMENT_UNAVAILABLE",
              "THS6_STAGING_NOT_DEPLOYED",
              "THS6_UPSTREAM_GATE_NOT_PASS"
            ],
            "type": "string"
          },
          "detail": {
            "minLength": 1,
            "type": "string"
          },
          "gate_id": {
            "pattern": "^GATE-[A-F]$",
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail",
          "owner",
          "blocking"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "demo_executed": {
      "type": "boolean"
    },
    "demo_execution_note": {
      "type": "string"
    },
    "demo_manifest_version": {
      "const": "pgx-wp25-demo-manifest/1",
      "type": "string"
    },
    "environment_conditions": {
      "items": {
        "type": "object"
      },
      "minItems": 3,
      "type": "array"
    },
    "exit_code": {
      "enum": [
        0,
        2
      ],
      "type": "integer"
    },
    "force_available": {
      "const": false,
      "type": "boolean"
    },
    "note": {
      "type": "string"
    },
    "preflight_state": {
      "enum": [
        "READY",
        "BLOCKED"
      ],
      "type": "string"
    },
    "step_count": {
      "minimum": 1,
      "type": "integer"
    },
    "steps": {
      "items": {
        "properties": {
          "preconditions": {
            "type": "array"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "enum": [
              "PRECONDITIONS_MET",
              "BLOCKED",
              "NOT_ATTEMPTED"
            ],
            "type": "string"
          },
          "step_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "step_id",
          "state",
          "reason"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "steps_not_attempted": {
      "minimum": 0,
      "type": "integer"
    },
    "steps_with_preconditions_met": {
      "minimum": 0,
      "type": "integer"
    },
    "stopped_at_step_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "unmet_environment_condition_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "demo_manifest_version",
    "preflight_state",
    "demo_executed",
    "stopped_at_step_id",
    "steps",
    "blockers",
    "exit_code",
    "force_available",
    "environment_conditions"
  ],
  "title": "WP-25 demonstration preflight",
  "type": "object"
}
