{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The representative workflow as declared. Environment requirements are declared here and measured in the preflight; keeping the observation out is what lets this document be compared byte for byte between machines.",
  "properties": {
    "demo_manifest_version": {
      "const": "pgx-wp25-demo-manifest/1",
      "type": "string"
    },
    "environment_requirements": {
      "items": {
        "properties": {
          "condition_id": {
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "note": {
            "minLength": 1,
            "type": "string"
          },
          "required": {},
          "source": {
            "type": "string"
          }
        },
        "required": [
          "condition_id",
          "description",
          "source",
          "note"
        ],
        "type": "object"
      },
      "minItems": 3,
      "type": "array"
    },
    "force_available": {
      "const": false,
      "type": "boolean"
    },
    "note": {
      "type": "string"
    },
    "step_count": {
      "minimum": 1,
      "type": "integer"
    },
    "steps": {
      "items": {
        "properties": {
          "observable_outcome": {
            "minLength": 1,
            "type": "string"
          },
          "precondition_count": {
            "minimum": 1,
            "type": "integer"
          },
          "preconditions": {
            "items": {
              "properties": {
                "blocker_code": {
                  "enum": [
                    "THS6_AUDIT_CHAIN_UNVERIFIED",
                    "THS6_BACKUP_RESTORE_NOT_VERIFIED",
                    "THS6_BENCHMARK_NOT_EXECUTED",
                    "THS6_CI_NOT_EXECUTED",
                    "THS6_CLAIM_BOUNDARY_NOT_APPROVED",
                    "THS6_CONTAINER_RUNTIME_UNAVAILABLE",
                    "THS6_CURATION_PROTOCOL_NOT_APPROVED",
                    "THS6_DATABASE_UNAVAILABLE",
                    "THS6_DATASET_NOT_PUBLISHED",
                    "THS6_DEMO_NOT_EXECUTED",
                    "THS6_DEPLOYMENT_GATE_BLOCKED",
                    "THS6_DOD_DECLARED_COUNT_MISMATCH",
                    "THS6_EVIDENCE_BUILD_NOT_APPROVED",
                    "THS6_EVIDENCE_INVALID",
                    "THS6_EVIDENCE_STALE",
                    "THS6_EVIDENCE_UNAVAILABLE",
                    "THS6_EXPERT_PROTOCOL_NOT_APPROVED",
                    "THS6_INSUFFICIENT_VALIDATION_CASES",
                    "THS6_LEGACY_WORK_ITEMS_UNLINKED",
                    "THS6_MIGRATION_NOT_EXECUTED",
                    "THS6_NO_ACTIVE_RELEASE",
                    "THS6_NO_APPROVED_RULE",
                    "THS6_NO_APPROVED_SOURCE",
                    "THS6_NO_COMPLETED_REVIEW",
                    "THS6_NO_COMPUTED_METRIC",
                    "THS6_NO_COVERAGE_EXECUTION",
                    "THS6_NO_CURATED_INTERPRETATION",
                    "THS6_NO_EXECUTABLE_RULESET",
                    "THS6_NO_HOLDOUT_SET",
                    "THS6_NO_HUMAN_SIGNOFF",
                    "THS6_NO_NAMED_REVIEWER",
                    "THS6_NO_REAL_ASSESSMENT",
                    "THS6_PROSE_INVENTORY_DISCREPANCY",
                    "THS6_SAFETY_CI_NOT_EXECUTED",
                    "THS6_SAFETY_GATE_BLOCKED",
                    "THS6_SECURITY_GATE_BLOCKED",
                    "THS6_SNAPSHOT_QUARANTINED",
                    "THS6_SOURCE_ARTIFACT_DISAGREEMENT",
                    "THS6_SOURCE_DOCUMENT_UNAVAILABLE",
                    "THS6_STAGING_NOT_DEPLOYED",
                    "THS6_UPSTREAM_GATE_NOT_PASS"
                  ],
                  "type": "string"
                },
                "description": {
                  "minLength": 1,
                  "type": "string"
                },
                "owner": {
                  "minLength": 1,
                  "type": "string"
                },
                "required": {},
                "source_field": {
                  "type": "string"
                },
                "source_path": {
                  "type": "string"
                }
              },
              "required": [
                "description",
                "source_path",
                "source_field",
                "blocker_code",
                "owner"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "step_id": {
            "pattern": "^DEMO-[0-9]{2}$",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "step_id",
          "title",
          "observable_outcome",
          "preconditions"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "demo_manifest_version",
    "step_count",
    "steps",
    "environment_requirements",
    "force_available"
  ],
  "title": "WP-25 demonstration manifest",
  "type": "object"
}
