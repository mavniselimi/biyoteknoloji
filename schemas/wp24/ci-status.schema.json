{
  "$id": "https://pgx.local/schemas/wp24/ci-status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Workflows existing is CONFIGURED. A provider having run them is a different fact, and ci_executed stays null until one is observed - not false, because 'nobody has run it' and 'a run failed' need different actions.",
  "if": {
    "properties": {
      "ci_executed": {
        "const": true
      }
    },
    "required": [
      "ci_executed"
    ]
  },
  "properties": {
    "blockers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "code": {
            "enum": [
              "DEPLOY_ADVISORY_DATABASE_UNAVAILABLE",
              "DEPLOY_ARGON2_UNAVAILABLE",
              "DEPLOY_BACKUP_NOT_EXECUTED",
              "DEPLOY_BUILD_BACKEND_UNAVAILABLE",
              "DEPLOY_CI_NOT_EXECUTED",
              "DEPLOY_CLAIM_BOUNDARY_NOT_APPROVED",
              "DEPLOY_COMPOSITION_INCOMPLETE",
              "DEPLOY_CONTAINER_RUNTIME_UNAVAILABLE",
              "DEPLOY_DATABASE_UNAVAILABLE",
              "DEPLOY_EXPERT_REVIEW_NOT_PERFORMED",
              "DEPLOY_IMAGE_NOT_BUILT",
              "DEPLOY_LOCKFILE_ABSENT",
              "DEPLOY_LOCKFILE_UNVERIFIED",
              "DEPLOY_MIGRATION_HEAD_MISMATCH",
              "DEPLOY_MIGRATION_NOT_EXECUTED",
              "DEPLOY_NO_ELIGIBLE_RELEASE",
              "DEPLOY_NO_HOLDOUT_EVIDENCE",
              "DEPLOY_NO_REAL_USERS",
              "DEPLOY_PACKAGE_INDEX_UNAVAILABLE",
              "DEPLOY_PERFORMANCE_NOT_EXECUTED",
              "DEPLOY_RESTORE_NOT_VERIFIED",
              "DEPLOY_ROLLBACK_NOT_EXERCISED",
              "DEPLOY_RUNTIME_ASSET_MISSING",
              "DEPLOY_SAFETY_GATE_BLOCKED",
              "DEPLOY_SBOM_NOT_GENERATED",
              "DEPLOY_SMOKE_NOT_EXECUTED",
              "DEPLOY_STAGING_NOT_DEPLOYED",
              "DEPLOY_TLS_NOT_OBSERVED",
              "DEPLOY_VULNERABILITY_SCANNER_UNAVAILABLE"
            ],
            "type": "string"
          },
          "detail": {
            "minLength": 1,
            "type": "string"
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail",
          "owner",
          "blocking"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ci_executed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "ci_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "ci_run_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "job_order": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "state": {
      "enum": [
        "CONFIGURED",
        "EXECUTED",
        "OBSERVED",
        "VERIFIED",
        "BLOCKED",
        "NOT_EXECUTED",
        "STALE",
        "NOT_APPLICABLE",
        "TEST_ONLY_REHEARSAL"
      ],
      "type": "string"
    },
    "workflows": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "state",
    "workflows",
    "ci_executed"
  ],
  "then": {
    "properties": {
      "ci_run_id": {
        "type": "string"
      }
    },
    "required": [
      "ci_run_id"
    ]
  },
  "title": "PGx continuous integration status (WP-24)",
  "type": "object"
}
