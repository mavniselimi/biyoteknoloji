{
  "$id": "https://pgx.local/schemas/wp24/migration-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Where the revision chain is, where a database is, and whether they agree. executed is false until a migration ran against a server; the chain is a fact about files and says nothing about any database.",
  "if": {
    "properties": {
      "executed": {
        "const": true
      }
    },
    "required": [
      "executed"
    ]
  },
  "properties": {
    "applied_head": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "code": {
            "enum": [
              "DEPLOY_ADVISORY_DATABASE_UNAVAILABLE",
              "DEPLOY_ARGON2_UNAVAILABLE",
              "DEPLOY_BACKUP_NOT_EXECUTED",
              "DEPLOY_BUILD_BACKEND_UNAVAILABLE",
              "DEPLOY_CI_NOT_EXECUTED",
              "DEPLOY_CLAIM_BOUNDARY_NOT_APPROVED",
              "DEPLOY_COMPOSITION_INCOMPLETE",
              "DEPLOY_CONTAINER_RUNTIME_UNAVAILABLE",
              "DEPLOY_DATABASE_UNAVAILABLE",
              "DEPLOY_EXPERT_REVIEW_NOT_PERFORMED",
              "DEPLOY_IMAGE_NOT_BUILT",
              "DEPLOY_LOCKFILE_ABSENT",
              "DEPLOY_LOCKFILE_UNVERIFIED",
              "DEPLOY_MIGRATION_HEAD_MISMATCH",
              "DEPLOY_MIGRATION_NOT_EXECUTED",
              "DEPLOY_NO_ELIGIBLE_RELEASE",
              "DEPLOY_NO_HOLDOUT_EVIDENCE",
              "DEPLOY_NO_REAL_USERS",
              "DEPLOY_PACKAGE_INDEX_UNAVAILABLE",
              "DEPLOY_PERFORMANCE_NOT_EXECUTED",
              "DEPLOY_RESTORE_NOT_VERIFIED",
              "DEPLOY_ROLLBACK_NOT_EXERCISED",
              "DEPLOY_RUNTIME_ASSET_MISSING",
              "DEPLOY_SAFETY_GATE_BLOCKED",
              "DEPLOY_SBOM_NOT_GENERATED",
              "DEPLOY_SMOKE_NOT_EXECUTED",
              "DEPLOY_STAGING_NOT_DEPLOYED",
              "DEPLOY_TLS_NOT_OBSERVED",
              "DEPLOY_VULNERABILITY_SCANNER_UNAVAILABLE"
            ],
            "type": "string"
          },
          "detail": {
            "minLength": 1,
            "type": "string"
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail",
          "owner",
          "blocking"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "chain": {
      "properties": {
        "file_count": {
          "minimum": 1,
          "type": "integer"
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "revision_count": {
          "minimum": 1,
          "type": "integer"
        },
        "single_head": {
          "type": "boolean"
        }
      },
      "required": [
        "revision_count",
        "heads",
        "single_head"
      ],
      "type": "object"
    },
    "database_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "database_revision_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "executed": {
      "type": "boolean"
    },
    "expected_head": {
      "type": [
        "string",
        "null"
      ]
    },
    "migration_result_version": {
      "const": "pgx-wp24-migration-result/1"
    },
    "state": {
      "enum": [
        "CONFIGURED",
        "EXECUTED",
        "OBSERVED",
        "VERIFIED",
        "BLOCKED",
        "NOT_EXECUTED",
        "STALE",
        "NOT_APPLICABLE",
        "TEST_ONLY_REHEARSAL"
      ],
      "type": "string"
    }
  },
  "required": [
    "migration_result_version",
    "state",
    "executed",
    "chain"
  ],
  "then": {
    "anyOf": [
      {
        "properties": {
          "database_revision": {
            "type": "string"
          }
        },
        "required": [
          "database_revision"
        ]
      },
      {
        "properties": {
          "applied_head": {
            "type": "string"
          }
        },
        "required": [
          "applied_head"
        ]
      }
    ]
  },
  "title": "PGx migration execution result (WP-24)",
  "type": "object"
}
