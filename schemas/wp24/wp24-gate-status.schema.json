{
  "$id": "https://pgx.local/schemas/wp24/wp24-gate-status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Implemented, configured and executed are three groups and they are allowed to disagree. In this repository the first is complete and the other two are almost entirely absent.",
  "if": {
    "properties": {
      "deployment_gate_status": {
        "const": "PASS"
      }
    },
    "required": [
      "deployment_gate_status"
    ]
  },
  "properties": {
    "argon2_available": {
      "type": "boolean"
    },
    "backup_operational_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "backup_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "code": {
            "enum": [
              "DEPLOY_ADVISORY_DATABASE_UNAVAILABLE",
              "DEPLOY_ARGON2_UNAVAILABLE",
              "DEPLOY_BACKUP_NOT_EXECUTED",
              "DEPLOY_BUILD_BACKEND_UNAVAILABLE",
              "DEPLOY_CI_NOT_EXECUTED",
              "DEPLOY_CLAIM_BOUNDARY_NOT_APPROVED",
              "DEPLOY_COMPOSITION_INCOMPLETE",
              "DEPLOY_CONTAINER_RUNTIME_UNAVAILABLE",
              "DEPLOY_DATABASE_UNAVAILABLE",
              "DEPLOY_EXPERT_REVIEW_NOT_PERFORMED",
              "DEPLOY_IMAGE_NOT_BUILT",
              "DEPLOY_LOCKFILE_ABSENT",
              "DEPLOY_LOCKFILE_UNVERIFIED",
              "DEPLOY_MIGRATION_HEAD_MISMATCH",
              "DEPLOY_MIGRATION_NOT_EXECUTED",
              "DEPLOY_NO_ELIGIBLE_RELEASE",
              "DEPLOY_NO_HOLDOUT_EVIDENCE",
              "DEPLOY_NO_REAL_USERS",
              "DEPLOY_PACKAGE_INDEX_UNAVAILABLE",
              "DEPLOY_PERFORMANCE_NOT_EXECUTED",
              "DEPLOY_RESTORE_NOT_VERIFIED",
              "DEPLOY_ROLLBACK_NOT_EXERCISED",
              "DEPLOY_RUNTIME_ASSET_MISSING",
              "DEPLOY_SAFETY_GATE_BLOCKED",
              "DEPLOY_SBOM_NOT_GENERATED",
              "DEPLOY_SMOKE_NOT_EXECUTED",
              "DEPLOY_STAGING_NOT_DEPLOYED",
              "DEPLOY_TLS_NOT_OBSERVED",
              "DEPLOY_VULNERABILITY_SCANNER_UNAVAILABLE"
            ],
            "type": "string"
          },
          "detail": {
            "minLength": 1,
            "type": "string"
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail",
          "owner",
          "blocking"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ci_action_pins_resolved": {
      "type": "boolean"
    },
    "ci_executed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "ci_workflows_present": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "compose_topology_present": {
      "type": "boolean"
    },
    "container_runtime_available": {
      "type": "boolean"
    },
    "database_url_configured": {
      "type": "boolean"
    },
    "deploy_cli_present": {
      "type": "boolean"
    },
    "deployment_gate_status": {
      "enum": [
        "PASS",
        "BLOCKED"
      ],
      "type": "string"
    },
    "deployment_package_present": {
      "type": "boolean"
    },
    "distribution_build_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "dockerfile_present": {
      "type": "boolean"
    },
    "dockerignore_present": {
      "type": "boolean"
    },
    "gate_status_schema_version": {
      "const": "pgx-wp24-gate-status/1"
    },
    "generated_at": {
      "type": "string"
    },
    "image_build_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "image_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "implementation_status": {
      "enum": [
        "IMPLEMENTED",
        "INCOMPLETE"
      ],
      "type": "string"
    },
    "lockfile_present": {
      "type": "boolean"
    },
    "lockfile_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "migration_executed": {
      "type": "boolean"
    },
    "migration_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "missing_markers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "module_markers_expected": {
      "minimum": 1,
      "type": "integer"
    },
    "module_markers_found": {
      "minimum": 0,
      "type": "integer"
    },
    "package_index_reachable": {
      "type": "boolean"
    },
    "performance_completed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "performance_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "release_may_proceed": {
      "type": "boolean"
    },
    "reliability_executed_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "reliability_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "restore_verified": {
      "type": "boolean"
    },
    "rollback_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_composition_implemented": {
      "type": "boolean"
    },
    "sbom_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "staging_environment_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "staging_smoke_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "tls_observed": {
      "type": "boolean"
    },
    "unmet_required_gates": {
      "type": "array"
    },
    "vulnerability_scan_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_package": {
      "const": "WP-24"
    }
  },
  "required": [
    "gate_status_schema_version",
    "work_package",
    "implementation_status",
    "deployment_gate_status",
    "release_may_proceed",
    "ci_executed",
    "migration_executed",
    "restore_verified"
  ],
  "then": {
    "properties": {
      "migration_executed": {
        "const": true
      },
      "release_may_proceed": {
        "const": true
      },
      "restore_verified": {
        "const": true
      }
    }
  },
  "title": "PGx WP-24 gate status (WP-24)",
  "type": "object"
}
