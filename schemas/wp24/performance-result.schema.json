{
  "$id": "https://pgx.local/schemas/wp24/performance-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "environment_kind": {
            "const": "LOCAL_REHEARSAL"
          }
        },
        "required": [
          "environment_kind"
        ]
      },
      "then": {
        "properties": {
          "rehearsal_label": {
            "const": "LOCAL_STAGING_REHEARSAL"
          }
        },
        "required": [
          "rehearsal_label"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "attempted": {
            "const": 0
          }
        },
        "required": [
          "attempted"
        ]
      },
      "then": {
        "properties": {
          "error_rate": {
            "type": "null"
          },
          "latency_p50_ms": {
            "type": "null"
          },
          "latency_p95_ms": {
            "type": "null"
          },
          "throughput_rps": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "EXECUTED",
              "VERIFIED",
              "OBSERVED"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "release_id": {
            "minLength": 1,
            "type": "string"
          },
          "release_manifest_hash": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    }
  ],
  "description": "Every measurement is nullable and none may be a false zero. A run that did not happen reports null latency, null throughput and a null error rate - a zero error rate for a run that never started is the most misleading number this document could carry.",
  "properties": {
    "attempted": {
      "minimum": 0,
      "type": "integer"
    },
    "attempts_meets_requirement": {
      "type": "boolean"
    },
    "attempts_required": {
      "const": 1000
    },
    "blockers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "code": {
            "enum": [
              "DEPLOY_ADVISORY_DATABASE_UNAVAILABLE",
              "DEPLOY_ARGON2_UNAVAILABLE",
              "DEPLOY_BACKUP_NOT_EXECUTED",
              "DEPLOY_BUILD_BACKEND_UNAVAILABLE",
              "DEPLOY_CI_NOT_EXECUTED",
              "DEPLOY_CLAIM_BOUNDARY_NOT_APPROVED",
              "DEPLOY_COMPOSITION_INCOMPLETE",
              "DEPLOY_CONTAINER_RUNTIME_UNAVAILABLE",
              "DEPLOY_DATABASE_UNAVAILABLE",
              "DEPLOY_EXPERT_REVIEW_NOT_PERFORMED",
              "DEPLOY_IMAGE_NOT_BUILT",
              "DEPLOY_LOCKFILE_ABSENT",
              "DEPLOY_LOCKFILE_UNVERIFIED",
              "DEPLOY_MIGRATION_HEAD_MISMATCH",
              "DEPLOY_MIGRATION_NOT_EXECUTED",
              "DEPLOY_NO_ELIGIBLE_RELEASE",
              "DEPLOY_NO_HOLDOUT_EVIDENCE",
              "DEPLOY_NO_REAL_USERS",
              "DEPLOY_PACKAGE_INDEX_UNAVAILABLE",
              "DEPLOY_PERFORMANCE_NOT_EXECUTED",
              "DEPLOY_RESTORE_NOT_VERIFIED",
              "DEPLOY_ROLLBACK_NOT_EXERCISED",
              "DEPLOY_RUNTIME_ASSET_MISSING",
              "DEPLOY_SAFETY_GATE_BLOCKED",
              "DEPLOY_SBOM_NOT_GENERATED",
              "DEPLOY_SMOKE_NOT_EXECUTED",
              "DEPLOY_STAGING_NOT_DEPLOYED",
              "DEPLOY_TLS_NOT_OBSERVED",
              "DEPLOY_VULNERABILITY_SCANNER_UNAVAILABLE"
            ],
            "type": "string"
          },
          "detail": {
            "minLength": 1,
            "type": "string"
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail",
          "owner",
          "blocking"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "completed": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "concurrency": {
      "minimum": 1,
      "type": "integer"
    },
    "dataset_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment_kind": {
      "enum": [
        "LOCAL_REHEARSAL",
        "CONTINUOUS_INTEGRATION",
        "STAGING",
        "PRODUCTION"
      ],
      "type": "string"
    },
    "error_rate": {
      "type": [
        "number",
        "null"
      ]
    },
    "failed": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "image_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_case_count": {
      "minimum": 0,
      "type": "integer"
    },
    "input_case_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "input_mix_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "latency_max_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "latency_min_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "latency_p50_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "latency_p95_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "latency_p99_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "output_determinism": {
      "type": "object"
    },
    "performance_result_version": {
      "const": "pgx-wp24-performance-result/1"
    },
    "rehearsal_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "release_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "release_manifest_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "resource_limits": {
      "type": "object"
    },
    "response_code_distribution": {
      "type": "object"
    },
    "ruleset_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "software_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "CONFIGURED",
        "EXECUTED",
        "OBSERVED",
        "VERIFIED",
        "BLOCKED",
        "NOT_EXECUTED",
        "STALE",
        "NOT_APPLICABLE",
        "TEST_ONLY_REHEARSAL"
      ],
      "type": "string"
    },
    "target_registry_version": {
      "const": "pgx-wp24-performance-targets/1"
    },
    "targets_evaluated": {
      "type": "array"
    },
    "test_only": {
      "type": "boolean"
    },
    "throughput_rps": {
      "type": [
        "number",
        "null"
      ]
    },
    "wall_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "warmup_attempts": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "performance_result_version",
    "state",
    "attempts_required",
    "attempted",
    "completed",
    "failed",
    "latency_p50_ms",
    "latency_p95_ms",
    "throughput_rps",
    "error_rate",
    "release_id",
    "release_manifest_hash",
    "environment_kind"
  ],
  "title": "PGx performance execution result (WP-24)",
  "type": "object"
}
