{
  "$id": "https://pgx.local/schemas/wp24/image-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "image_digest is present only when an image has been pushed or pulled; a purely local build has no repository digest, and inventing one would claim a registry identity that does not exist.",
  "properties": {
    "architecture": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_image_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "code": {
            "enum": [
              "DEPLOY_ADVISORY_DATABASE_UNAVAILABLE",
              "DEPLOY_ARGON2_UNAVAILABLE",
              "DEPLOY_BACKUP_NOT_EXECUTED",
              "DEPLOY_BUILD_BACKEND_UNAVAILABLE",
              "DEPLOY_CI_NOT_EXECUTED",
              "DEPLOY_CLAIM_BOUNDARY_NOT_APPROVED",
              "DEPLOY_COMPOSITION_INCOMPLETE",
              "DEPLOY_CONTAINER_RUNTIME_UNAVAILABLE",
              "DEPLOY_DATABASE_UNAVAILABLE",
              "DEPLOY_EXPERT_REVIEW_NOT_PERFORMED",
              "DEPLOY_IMAGE_NOT_BUILT",
              "DEPLOY_LOCKFILE_ABSENT",
              "DEPLOY_LOCKFILE_UNVERIFIED",
              "DEPLOY_MIGRATION_HEAD_MISMATCH",
              "DEPLOY_MIGRATION_NOT_EXECUTED",
              "DEPLOY_NO_ELIGIBLE_RELEASE",
              "DEPLOY_NO_HOLDOUT_EVIDENCE",
              "DEPLOY_NO_REAL_USERS",
              "DEPLOY_PACKAGE_INDEX_UNAVAILABLE",
              "DEPLOY_PERFORMANCE_NOT_EXECUTED",
              "DEPLOY_RESTORE_NOT_VERIFIED",
              "DEPLOY_ROLLBACK_NOT_EXERCISED",
              "DEPLOY_RUNTIME_ASSET_MISSING",
              "DEPLOY_SAFETY_GATE_BLOCKED",
              "DEPLOY_SBOM_NOT_GENERATED",
              "DEPLOY_SMOKE_NOT_EXECUTED",
              "DEPLOY_STAGING_NOT_DEPLOYED",
              "DEPLOY_TLS_NOT_OBSERVED",
              "DEPLOY_VULNERABILITY_SCANNER_UNAVAILABLE"
            ],
            "type": "string"
          },
          "detail": {
            "minLength": 1,
            "type": "string"
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail",
          "owner",
          "blocking"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "entrypoint": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "exposed_ports": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "image_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "image_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "image_result_version": {
      "const": "pgx-wp24-image-result/1"
    },
    "layer_diff_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "os": {
      "type": [
        "string",
        "null"
      ]
    },
    "reference": {
      "type": "string"
    },
    "runtime_assets": {
      "type": "object"
    },
    "size_bytes": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "state": {
      "enum": [
        "CONFIGURED",
        "EXECUTED",
        "OBSERVED",
        "VERIFIED",
        "BLOCKED",
        "NOT_EXECUTED",
        "STALE",
        "NOT_APPLICABLE",
        "TEST_ONLY_REHEARSAL"
      ],
      "type": "string"
    },
    "user": {
      "not": {
        "enum": [
          "root",
          "0",
          "0:0"
        ]
      },
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "image_result_version",
    "state",
    "reference",
    "image_id",
    "image_digest"
  ],
  "title": "PGx image build result (WP-24)",
  "type": "object"
}
