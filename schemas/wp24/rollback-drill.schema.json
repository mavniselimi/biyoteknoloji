{
  "$id": "https://pgx.local/schemas/wp24/rollback-drill.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "environment_kind": {
            "const": "LOCAL_REHEARSAL"
          }
        },
        "required": [
          "environment_kind"
        ]
      },
      "then": {
        "properties": {
          "rehearsal_label": {
            "const": "LOCAL_STAGING_REHEARSAL"
          }
        },
        "required": [
          "rehearsal_label"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "database_downgraded": {
            "const": false
          }
        }
      }
    }
  ],
  "description": "Two operations share the word rollback. A deployment rollback must not downgrade the schema, and a governed release rollback never edits a manifest.",
  "properties": {
    "active_release_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "audited_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "code": {
            "enum": [
              "DEPLOY_ADVISORY_DATABASE_UNAVAILABLE",
              "DEPLOY_ARGON2_UNAVAILABLE",
              "DEPLOY_BACKUP_NOT_EXECUTED",
              "DEPLOY_BUILD_BACKEND_UNAVAILABLE",
              "DEPLOY_CI_NOT_EXECUTED",
              "DEPLOY_CLAIM_BOUNDARY_NOT_APPROVED",
              "DEPLOY_COMPOSITION_INCOMPLETE",
              "DEPLOY_CONTAINER_RUNTIME_UNAVAILABLE",
              "DEPLOY_DATABASE_UNAVAILABLE",
              "DEPLOY_EXPERT_REVIEW_NOT_PERFORMED",
              "DEPLOY_IMAGE_NOT_BUILT",
              "DEPLOY_LOCKFILE_ABSENT",
              "DEPLOY_LOCKFILE_UNVERIFIED",
              "DEPLOY_MIGRATION_HEAD_MISMATCH",
              "DEPLOY_MIGRATION_NOT_EXECUTED",
              "DEPLOY_NO_ELIGIBLE_RELEASE",
              "DEPLOY_NO_HOLDOUT_EVIDENCE",
              "DEPLOY_NO_REAL_USERS",
              "DEPLOY_PACKAGE_INDEX_UNAVAILABLE",
              "DEPLOY_PERFORMANCE_NOT_EXECUTED",
              "DEPLOY_RESTORE_NOT_VERIFIED",
              "DEPLOY_ROLLBACK_NOT_EXERCISED",
              "DEPLOY_RUNTIME_ASSET_MISSING",
              "DEPLOY_SAFETY_GATE_BLOCKED",
              "DEPLOY_SBOM_NOT_GENERATED",
              "DEPLOY_SMOKE_NOT_EXECUTED",
              "DEPLOY_STAGING_NOT_DEPLOYED",
              "DEPLOY_TLS_NOT_OBSERVED",
              "DEPLOY_VULNERABILITY_SCANNER_UNAVAILABLE"
            ],
            "type": "string"
          },
          "detail": {
            "minLength": 1,
            "type": "string"
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail",
          "owner",
          "blocking"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "candidate_image": {
      "type": [
        "object",
        "null"
      ]
    },
    "database_downgraded": {
      "type": "boolean"
    },
    "eligible_release_count": {
      "minimum": 0,
      "type": "integer"
    },
    "environment_kind": {
      "enum": [
        "LOCAL_REHEARSAL",
        "CONTINUOUS_INTEGRATION",
        "STAGING",
        "PRODUCTION"
      ],
      "type": "string"
    },
    "health_after": {
      "type": [
        "object",
        "null"
      ]
    },
    "health_before": {
      "type": [
        "object",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "deployment_image",
        "governed_release"
      ],
      "type": "string"
    },
    "manifest_edited": {
      "const": false
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_image": {
      "type": [
        "object",
        "null"
      ]
    },
    "rehearsal_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "rollback_result_version": {
      "const": "pgx-wp24-rollback-drill/1"
    },
    "rollback_target_explicit": {
      "type": "boolean"
    },
    "rolled_back_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "CONFIGURED",
        "EXECUTED",
        "OBSERVED",
        "VERIFIED",
        "BLOCKED",
        "NOT_EXECUTED",
        "STALE",
        "NOT_APPLICABLE",
        "TEST_ONLY_REHEARSAL"
      ],
      "type": "string"
    },
    "test_only": {
      "type": "boolean"
    }
  },
  "required": [
    "rollback_result_version",
    "kind",
    "state"
  ],
  "title": "PGx rollback drill result (WP-24)",
  "type": "object"
}
