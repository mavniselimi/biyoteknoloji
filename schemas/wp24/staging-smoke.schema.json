{
  "$id": "https://pgx.local/schemas/wp24/staging-smoke.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Status codes, component names and cookie attribute compliance. No response body appears here: a smoke report that captured bodies would capture whatever the deployment was serving.",
  "if": {
    "properties": {
      "environment_kind": {
        "const": "LOCAL_REHEARSAL"
      }
    },
    "required": [
      "environment_kind"
    ]
  },
  "properties": {
    "base_url_scheme": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "code": {
            "enum": [
              "DEPLOY_ADVISORY_DATABASE_UNAVAILABLE",
              "DEPLOY_ARGON2_UNAVAILABLE",
              "DEPLOY_BACKUP_NOT_EXECUTED",
              "DEPLOY_BUILD_BACKEND_UNAVAILABLE",
              "DEPLOY_CI_NOT_EXECUTED",
              "DEPLOY_CLAIM_BOUNDARY_NOT_APPROVED",
              "DEPLOY_COMPOSITION_INCOMPLETE",
              "DEPLOY_CONTAINER_RUNTIME_UNAVAILABLE",
              "DEPLOY_DATABASE_UNAVAILABLE",
              "DEPLOY_EXPERT_REVIEW_NOT_PERFORMED",
              "DEPLOY_IMAGE_NOT_BUILT",
              "DEPLOY_LOCKFILE_ABSENT",
              "DEPLOY_LOCKFILE_UNVERIFIED",
              "DEPLOY_MIGRATION_HEAD_MISMATCH",
              "DEPLOY_MIGRATION_NOT_EXECUTED",
              "DEPLOY_NO_ELIGIBLE_RELEASE",
              "DEPLOY_NO_HOLDOUT_EVIDENCE",
              "DEPLOY_NO_REAL_USERS",
              "DEPLOY_PACKAGE_INDEX_UNAVAILABLE",
              "DEPLOY_PERFORMANCE_NOT_EXECUTED",
              "DEPLOY_RESTORE_NOT_VERIFIED",
              "DEPLOY_ROLLBACK_NOT_EXERCISED",
              "DEPLOY_RUNTIME_ASSET_MISSING",
              "DEPLOY_SAFETY_GATE_BLOCKED",
              "DEPLOY_SBOM_NOT_GENERATED",
              "DEPLOY_SMOKE_NOT_EXECUTED",
              "DEPLOY_STAGING_NOT_DEPLOYED",
              "DEPLOY_TLS_NOT_OBSERVED",
              "DEPLOY_VULNERABILITY_SCANNER_UNAVAILABLE"
            ],
            "type": "string"
          },
          "detail": {
            "minLength": 1,
            "type": "string"
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail",
          "owner",
          "blocking"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "cookie_policy": {
      "type": [
        "object",
        "null"
      ]
    },
    "environment_kind": {
      "enum": [
        "LOCAL_REHEARSAL",
        "CONTINUOUS_INTEGRATION",
        "STAGING",
        "PRODUCTION"
      ],
      "type": "string"
    },
    "liveness": {
      "type": [
        "object",
        "null"
      ]
    },
    "login_page_status": {
      "type": [
        "integer",
        "null"
      ]
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "readiness": {
      "type": [
        "object",
        "null"
      ]
    },
    "rehearsal_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "staging_smoke_version": {
      "const": "pgx-wp24-staging-smoke/1"
    },
    "state": {
      "enum": [
        "CONFIGURED",
        "EXECUTED",
        "OBSERVED",
        "VERIFIED",
        "BLOCKED",
        "NOT_EXECUTED",
        "STALE",
        "NOT_APPLICABLE",
        "TEST_ONLY_REHEARSAL"
      ],
      "type": "string"
    },
    "tls_trust_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "tls_used": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "tls_verification_disabled": {
      "const": false
    }
  },
  "required": [
    "staging_smoke_version",
    "state",
    "environment_kind"
  ],
  "then": {
    "properties": {
      "rehearsal_label": {
        "const": "LOCAL_STAGING_REHEARSAL"
      }
    },
    "required": [
      "rehearsal_label"
    ]
  },
  "title": "PGx staging smoke result (WP-24)",
  "type": "object"
}
