{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgx-platform.invalid/schemas/ruleset-coverage-manifest.schema.json",
  "title": "PGx ruleset coverage manifest",
  "description": "What one frozen ruleset is declared able to evaluate. This is a separate document from WP-11's ruleset manifest on purpose: that one lists the axes the member rules happen to be keyed on and says in its own note that this is a membership inventory rather than a coverage claim. The load-bearing field here is expected_gene_keys, which says which genes a complete assessment of a drug would have to consider. It is required and non-empty for every declared drug, because a drug with an empty expected scope can never be incompletely covered - which is the one thing coverage exists to detect - and it cannot be derived from the supported axes, from the chemical catalogue, from guideline presence or from a legacy row. Every supported axis must name the exact validated rule that covers it, its content hash, and at least one evidence reference. additionalProperties is false throughout, which is where the separation of coverage from attention is actually enforced: an attention level, an overall_attention, a risk level, a risk score, a severity, a dose, a recommendation, a preferred or safer flag, a suitability score or a treatment cannot be attached to any of these documents by anything downstream, because the schema refuses every property it does not name. WP-13 computes coverage; WP-14 computes attention; a document that could carry both would let one be read as the other.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coverage_schema_version",
    "ruleset_public_id",
    "ruleset_version",
    "ruleset_content_hash",
    "dataset_public_id",
    "canonical_build_key",
    "canonical_build_content_hash",
    "evidence_build_key",
    "evidence_build_content_hash",
    "protocol_version",
    "protocol_content_hash",
    "source_policy_version",
    "source_policy_content_hash",
    "declaration_count",
    "declarations",
    "approval",
    "note",
    "content_hash"
  ],
  "properties": {
    "coverage_schema_version": {
      "const": "pgx-ruleset-coverage-manifest/1"
    },
    "ruleset_public_id": {
      "type": "string",
      "pattern": "^PGX-RULESET-[0-9]{8}-[0-9]{3}$"
    },
    "ruleset_version": {
      "type": "integer",
      "minimum": 1
    },
    "ruleset_content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dataset_public_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_build_key": {
      "type": "string",
      "minLength": 1
    },
    "canonical_build_content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_build_key": {
      "type": "string",
      "minLength": 1
    },
    "evidence_build_content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "protocol_content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "source_policy_content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "declaration_count": {
      "type": "integer",
      "minimum": 1
    },
    "declarations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "declaration_id",
          "drug_id",
          "expected_gene_keys",
          "supported_axes",
          "conflict_references",
          "declared_by",
          "declaration_provenance"
        ],
        "properties": {
          "declaration_id": {
            "type": "string",
            "minLength": 1
          },
          "drug_id": {
            "type": "string",
            "pattern": "^DRUG:[^A-Z\\s]+( [^A-Z\\s]+)*$"
          },
          "expected_gene_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^GENE:[A-Z0-9][A-Z0-9\\-.@_]*$"
            }
          },
          "supported_axes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "drug_id",
                "gene_id",
                "phenotype",
                "rule_id",
                "rule_version",
                "rule_content_hash",
                "evidence_references"
              ],
              "properties": {
                "drug_id": {
                  "type": "string",
                  "pattern": "^DRUG:[^A-Z\\s]+( [^A-Z\\s]+)*$"
                },
                "gene_id": {
                  "type": "string",
                  "pattern": "^GENE:[A-Z0-9][A-Z0-9\\-.@_]*$"
                },
                "phenotype": {
                  "enum": [
                    "POOR",
                    "INTERMEDIATE",
                    "NORMAL",
                    "RAPID",
                    "ULTRARAPID"
                  ]
                },
                "rule_id": {
                  "type": "string",
                  "minLength": 1
                },
                "rule_version": {
                  "type": "integer",
                  "minimum": 1
                },
                "rule_content_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "evidence_references": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "conflict_references": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "declared_by": {
            "type": "string",
            "minLength": 1
          },
          "declaration_provenance": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_by",
        "reviewed_by",
        "approved_by",
        "approved_at",
        "approval_reference",
        "synthetic"
      ],
      "properties": {
        "declared_by": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "minLength": 1
        },
        "approval_reference": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        }
      }
    },
    "note": {
      "type": "string",
      "minLength": 100
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
