      },
      "required": [
        "codes",
        "kind",
        "references",
        "statement_text",
        "subject"
      ],
      "type": "object"
    }
  },
  "$id": "https://pgx-platform.invalid/schemas/structured-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One report before it is rendered into any format. A presentation projection: every value in it came from the assessment or from a fixed label table, and additionalProperties is false throughout, so a dose, a recommendation, a score, a ranking or an authored sentence cannot be attached to it. report_hash covers the validated content plus the template version, the locale and the report schema version, which is exactly how it differs from output_hash.",
  "properties": {
    "adjacency_note": {
      "minLength": 1,
      "type": "string"
    },
    "assessment_engine_contract_version": {
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "type": "string"
    },
    "canonical_result_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "canonical_warning": {
      "minLength": 200,
      "type": "string"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "computation_schema_version": {
      "type": "string"
    },
    "coverage_result_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "disclaimer": {
      "minLength": 100,
      "type": "string"
    },
    "input_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "input_kind_code": {
      "minLength": 1,
      "type": "string"
    },
    "input_kind_label": {
      "minLength": 1,
      "type": "string"
    },
    "locale": {
      "enum": [
        "tr",
        "en"
      ]
    },
    "medication_count": {
      "minimum": 1,
      "type": "integer"
    },
    "medications": {
      "items": {
        "$ref": "#/$defs/section"
      },
      "minItems": 1,
      "type": "array"
    },
    "mode_code": {
      "enum": [
        "DEMO",
        "VALIDATION",
        "PILOT"
      ]
    },
    "mode_label": {
      "minLength": 1,
      "type": "string"
    },
    "output_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "overall": {
      "$ref": "#/$defs/status"
    },
    "pointer_audit": {
      "type": "object"
    },
    "profile_note": {
      "minLength": 1,
      "type": "string"
    },
    "profile_observations": {
      "items": {
        "$ref": "#/$defs/observation"
      },
      "type": "array"
    },
    "question_labels": {
      "type": "object"
    },
    "release_provenance": {
      "type": "object"
    },
    "report_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "report_schema_version": {
      "const": "pgx-structured-report/1"
    },
    "section_titles": {
      "type": "object"
    },
    "template_version": {
      "minLength": 1,
      "type": "string"
    },
    "uncertainty": {
      "items": {
        "$ref": "#/$defs/uncertaintyItem"
      },
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "adjacency_note",
    "assessment_id",
    "canonical_result_hash",
    "canonical_warning",
    "coverage_result_hash",
    "disclaimer",
    "input_hash",
    "input_kind_code",
    "input_kind_label",
    "locale",
    "medication_count",
    "medications",
    "mode_code",
    "mode_label",
    "output_hash",
    "overall",
    "pointer_audit",
    "profile_observations",
    "release_provenance",
    "report_hash",
    "report_schema_version",
    "template_version",
    "uncertainty",
    "warnings"
  ],
  "title": "PGx structured report",
  "type": "object"
}
