          },
          "type": "array",
          "uniqueItems": true
        },
        "reason_labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rule_references": {
          "items": {
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "conflict_references",
        "coverage_code",
        "coverage_label",
        "declaration_id",
        "drug_canonical_key",
        "evidence_references",
        "gene_canonical_key",
        "observation_state_code",
        "observation_state_label",
        "observed_phenotype",
        "reason_codes",
        "reason_labels",
        "rule_references"
      ],
      "type": "object"
    },
    "findingLine": {
      "additionalProperties": false,
      "description": "Where the governed ruleset carries no effect or explanation code, both are null and codes_absent_statement carries the controlled sentence saying so. Nothing is invented to fill the gap.",
      "properties": {
        "attention_code": {
          "enum": [
            "NO_ACTIVE_ATTENTION",
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "attention_label": {
          "minLength": 1,
          "type": "string"
        },
        "codes_absent_statement": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "curation_revision_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "curation_revision_id": {
          "minLength": 1,
          "type": "string"
        },
        "drug_canonical_key": {
          "minLength": 1,
          "type": "string"
        },
        "effect_code": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "evidence_references": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "explanation_code": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "gene_canonical_key": {
          "minLength": 1,
          "type": "string"
        },
        "phenotype": {
          "enum": [
            "POOR",
            "INTERMEDIATE",
            "NORMAL",
            "RAPID",
            "ULTRARAPID"
          ]
        },
        "rationale_reference": {
          "minLength": 1,
          "type": "string"
        },
        "rule_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "rule_family_id": {
          "minLength": 1,
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "type": "string"
        },
        "rule_version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "attention_code",
        "attention_label",
        "codes_absent_statement",
        "curation_revision_hash",
        "curation_revision_id",
        "drug_canonical_key",
        "effect_code",
        "evidence_references",
        "explanation_code",
        "gene_canonical_key",
        "phenotype",
        "rationale_reference",
        "rule_content_hash",
        "rule_family_id",
        "rule_id",
        "rule_version"
      ],
      "type": "object"
    },
    "observation": {
      "additionalProperties": false,
      "properties": {
        "gene_id": {
          "minLength": 1,
          "type": "string"
        },
        "phenotype": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "POOR",
                "INTERMEDIATE",
                "NORMAL",
                "RAPID",
                "ULTRARAPID"
              ]
            }
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "status": {
          "enum": [
            "NORMALIZED",
            "MISSING",
            "INDETERMINATE",
            "UNSUPPORTED"
          ]
        }
      },
      "required": [
        "gene_id",
        "phenotype",
        "reason_code",
        "status"
      ],
      "type": "object"
    },
    "section": {
      "additionalProperties": false,
      "properties": {
        "answers": {
          "additionalProperties": false,
          "description": "The eight questions every medication section answers. All eight are required: a section that answered seven would leave the reader to supply the eighth.",
          "properties": {
            "attention_level": {
              "$ref": "#/$defs/answer"
            },
            "coverage": {
              "$ref": "#/$defs/answer"
            },
            "evidence": {
              "$ref": "#/$defs/answer"
            },
            "limits": {
              "$ref": "#/$defs/answer"
            },
            "not_assessed": {
              "$ref": "#/$defs/answer"
            },
            "rules": {
              "$ref": "#/$defs/answer"
            },
            "versions": {
              "$ref": "#/$defs/answer"
            },
            "which_medication": {
              "$ref": "#/$defs/answer"
            }
          },
          "required": [
            "attention_level",
            "coverage",
            "evidence",
            "limits",
            "not_assessed",
            "rules",
            "versions",
            "which_medication"
          ],
          "type": "object"
        },
        "axes": {
          "items": {
            "$ref": "#/$defs/axisLine"
          },
          "type": "array"
        },
        "axis_count": {
          "minimum": 0,
          "type": "integer"
        },
        "conflict_axes": {
          "items": {
            "$ref": "#/$defs/axisLine"
          },
          "type": "array"
        },
        "conflict_references": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "conflicted_axis_count": {
          "minimum": 0,
          "type": "integer"
        },
        "drug_canonical_key": {
          "minLength": 1,
          "type": "string"
        },
        "evidence_references": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/findingLine"
          },
          "type": "array"
        },
        "not_assessed_axes": {
          "items": {
            "$ref": "#/$defs/axisLine"
          },
          "type": "array"
        },
        "requested_value": {
          "type": "string"
        },
        "rule_references": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      },
      "required": [
        "answers",
        "axes",
        "axis_count",
        "conflict_axes",
        "conflict_references",
        "conflicted_axis_count",
        "drug_canonical_key",
        "evidence_references",
        "findings",
        "not_assessed_axes",
        "requested_value",
        "rule_references",
        "status"
      ],
      "type": "object"
    },
    "status": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "attention_code": {
                "const": "NO_ACTIVE_ATTENTION"
              }
            },
            "required": [
              "attention_code"
            ]
          },
          "then": {
            "properties": {
              "coverage_code": {
                "const": "FULL"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "reason_codes": {
                "minItems": 1
              }
            }
          },
          "if": {
            "properties": {
              "coverage_code": {
                "const": "FULL"
              }
            },
            "required": [
              "coverage_code"
            ]
          },
          "then": {
            "properties": {
              "reason_codes": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "description": "Attention and coverage in one block. Every code is displayed beside its controlled label, never replaced by it, and neither half can be present without the other.",
      "properties": {
        "adjacency_note": {
          "minLength": 1,
          "type": "string"
        },
        "attention_code": {
          "enum": [
            "NOT_ASSESSED",
            "NO_ACTIVE_ATTENTION",
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "attention_label": {
          "minLength": 1,
          "type": "string"
        },
        "coverage_code": {
          "enum": [
            "FULL",
            "PARTIAL",
            "INSUFFICIENT",
            "UNSUPPORTED_DRUG",
            "UNSUPPORTED_PHENOTYPE",
            "SOURCE_CONFLICT"
          ]
        },
        "coverage_label": {
          "minLength": 1,
          "type": "string"
        },
        "qualifier_statements": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "enum": [
              "DRUG_NOT_IN_CANONICAL_DATASET",
              "PHENOTYPE_NOT_PROVIDED",
              "PHENOTYPE_NOT_SUPPORTED",
              "NO_VALIDATED_RULE_FOR_AXIS",
              "SOME_AXES_NOT_COVERED",
              "VALIDATED_RULES_CONFLICT",
              "DATASET_RULESET_MISMATCH",
              "EVIDENCE_REFERENCE_MISSING"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "reason_labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "adjacency_note",
        "attention_code",
        "attention_label",
        "coverage_code",
        "coverage_label",
        "qualifier_statements",
        "reason_codes",
        "reason_labels"
      ],
      "type": "object"
    },
    "uncertaintyItem": {
      "additionalProperties": false,
      "properties": {
        "codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
