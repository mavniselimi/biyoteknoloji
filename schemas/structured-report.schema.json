            "UNSUPPORTED_DRUG",
            "UNSUPPORTED_PHENOTYPE",
            "SOURCE_CONFLICT"
          ]
        },
        "coverage_label": {
          "minLength": 1,
          "type": "string"
        },
        "declaration_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "drug_canonical_key": {
          "minLength": 1,
          "type": "string"
        },
        "evidence_references": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "gene_canonical_key": {
          "minLength": 1,
          "type": "string"
        },
        "observation_state_code": {
          "minLength": 1,
          "type": "string"
        },
        "observation_state_label": {
          "minLength": 1,
          "type": "string"
        },
        "observed_phenotype": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "POOR",
                "INTERMEDIATE",
                "NORMAL",
                "RAPID",
                "ULTRARAPID"
              ]
            }
          ]
        },
        "reason_codes": {
          "items": {
            "enum": [
              "DRUG_NOT_IN_CANONICAL_DATASET",
              "PHENOTYPE_NOT_PROVIDED",
              "PHENOTYPE_NOT_SUPPORTED",
              "NO_VALIDATED_RULE_FOR_AXIS",
              "SOME_AXES_NOT_COVERED",
              "VALIDATED_RULES_CONFLICT",
              "DATASET_RULESET_MISMATCH",
              "EVIDENCE_REFERENCE_MISSING"
