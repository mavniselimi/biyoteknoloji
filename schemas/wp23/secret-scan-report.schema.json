{
  "$id": "https://pgx.local/schemas/wp23/secret-scan-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "CLEAN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "finding_count": {
            "const": 0
          },
          "findings": {
            "maxItems": 0,
            "type": "array"
          }
        }
      }
    }
  ],
  "description": "Locations and rule ids. A finding has a path, a line and a rule and no property a matched value could occupy - a scanner that printed what it found would be the disclosure it exists to prevent.",
  "properties": {
    "allowlist": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "allowlist_count": {
      "minimum": 0,
      "type": "integer"
    },
    "allowlist_policy": {
      "minLength": 40,
      "type": "string"
    },
    "classified_finding_count": {
      "minimum": 0,
      "type": "integer"
    },
    "classified_findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "classification": {
            "enum": [
              "FINDING",
              "ALLOWLISTED",
              "NEGATIVE_FIXTURE"
            ],
            "type": "string"
          },
          "line": {
            "minimum": 0,
            "type": "integer"
          },
          "matched_length": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "rule_id": {
            "minLength": 3,
            "type": "string"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ],
            "type": "string"
          }
        },
        "required": [
          "path",
          "line",
          "rule_id",
          "severity",
          "classification",
          "matched_length"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "finding_count": {
      "minimum": 0,
      "type": "integer"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "classification": {
            "enum": [
              "FINDING",
              "ALLOWLISTED",
              "NEGATIVE_FIXTURE"
            ],
            "type": "string"
          },
          "line": {
            "minimum": 0,
            "type": "integer"
          },
          "matched_length": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "rule_id": {
            "minLength": 3,
            "type": "string"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ],
            "type": "string"
          }
        },
        "required": [
          "path",
          "line",
          "rule_id",
          "severity",
          "classification",
          "matched_length"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "negative_fixture_count": {
      "minimum": 0,
      "type": "integer"
    },
    "negative_fixtures": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "no_value_is_reported": {
      "minLength": 40,
      "type": "string"
    },
    "rule_count": {
      "minimum": 1,
      "type": "integer"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "rationale": {
            "minLength": 40,
            "type": "string"
          },
          "rule_id": {
            "minLength": 3,
            "type": "string"
          },
          "severity": {
            "minLength": 3,
            "type": "string"
          },
          "title": {
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "rule_id",
          "title",
          "severity",
          "rationale"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "scanned_file_count": {
      "minimum": 0,
      "type": "integer"
    },
    "secret_scan_version": {
      "const": "pgx-wp23-secret-scan/1"
    },
    "status": {
      "enum": [
        "CLEAN",
        "FINDINGS"
      ],
      "type": "string"
    }
  },
  "required": [
    "secret_scan_version",
    "rule_count",
    "rules",
    "allowlist",
    "scanned_file_count",
    "finding_count",
    "findings",
    "status",
    "no_value_is_reported",
    "allowlist_policy"
  ],
  "title": "WP-23 secret scan report",
  "type": "object"
}
