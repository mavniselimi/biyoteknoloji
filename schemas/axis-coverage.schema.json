{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgx-platform.invalid/schemas/axis-coverage.schema.json",
  "title": "PGx axis coverage",
  "description": "What could be evaluated for one drug-gene axis, and why not. FULL is reachable only with an observed phenotype, at least one validated rule reference and at least one resolvable evidence reference, and the schema enforces all three rather than trusting the producer: an axis reported as covered without evidence would be an assertion wearing the appearance of a finding (SAFETY-INV-006). Every non-FULL status carries at least one machine-readable reason, because unexplained absence is how absence becomes reassurance. additionalProperties is false throughout, which is where the separation of coverage from attention is actually enforced: an attention level, an overall_attention, a risk level, a risk score, a severity, a dose, a recommendation, a preferred or safer flag, a suitability score or a treatment cannot be attached to any of these documents by anything downstream, because the schema refuses every property it does not name. WP-13 computes coverage; WP-14 computes attention; a document that could carry both would let one be read as the other.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "axis_coverage_schema_version",
    "drug_id",
    "gene_id",
    "status",
    "reason_codes",
    "observed_phenotype",
    "observation_state",
    "declaration_id",
    "rule_references",
    "evidence_references",
    "conflict_references",
    "ruleset_public_id",
    "ruleset_content_hash",
    "dataset_public_id",
    "canonical_build_content_hash",
    "coverage_manifest_hash"
  ],
  "properties": {
    "axis_coverage_schema_version": {
      "const": "pgx-axis-coverage/1"
    },
    "drug_id": {
      "type": "string",
      "pattern": "^DRUG:[^A-Z\\s]+( [^A-Z\\s]+)*$"
    },
    "gene_id": {
      "type": "string",
      "pattern": "^GENE:[A-Z0-9][A-Z0-9\\-.@_]*$"
    },
    "status": {
      "enum": [
        "FULL",
        "PARTIAL",
        "INSUFFICIENT",
        "UNSUPPORTED_DRUG",
        "UNSUPPORTED_PHENOTYPE",
        "SOURCE_CONFLICT"
      ]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "DRUG_NOT_IN_CANONICAL_DATASET",
          "PHENOTYPE_NOT_PROVIDED",
          "PHENOTYPE_NOT_SUPPORTED",
          "NO_VALIDATED_RULE_FOR_AXIS",
          "SOME_AXES_NOT_COVERED",
          "VALIDATED_RULES_CONFLICT",
          "DATASET_RULESET_MISMATCH",
          "EVIDENCE_REFERENCE_MISSING"
        ]
      }
    },
    "observed_phenotype": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "POOR",
            "INTERMEDIATE",
            "NORMAL",
            "RAPID",
            "ULTRARAPID"
          ]
        }
      ]
    },
    "observation_state": {
      "type": "string"
    },
    "declaration_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "rule_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "rule_version",
          "rule_content_hash"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_version": {
            "type": "integer",
            "minimum": 0
          },
          "rule_content_hash": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 0
              },
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            ]
          }
        }
      }
    },
    "evidence_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conflict_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ruleset_public_id": {
      "type": "string"
    },
    "ruleset_content_hash": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 0
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "dataset_public_id": {
      "type": "string"
    },
    "canonical_build_content_hash": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 0
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "coverage_manifest_hash": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 0
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "FULL"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "maxItems": 0
          },
          "observed_phenotype": {
            "enum": [
              "POOR",
              "INTERMEDIATE",
              "NORMAL",
              "RAPID",
              "ULTRARAPID"
            ]
          },
          "rule_references": {
            "minItems": 1
          },
          "evidence_references": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SOURCE_CONFLICT"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "conflict_references": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
